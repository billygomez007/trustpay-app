# Runtime environment
NODE_ENV=development

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Data services (use development-only local values)
DATABASE_URL=postgresql://trustpay:trustpay@localhost:5432/trustpay?schema=public
REDIS_URL=redis://localhost:6379

# Authentication and provider integration placeholders
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-a-provider-specific-secret
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key
PAYSTACK_API_BASE_URL=https://api.paystack.co
